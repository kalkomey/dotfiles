# Language runtimes and CLI tools (node, ruby, terraform, vault, nomad, consul,
# aws-cli, aws-vault, gh, jq, fzf, ripgrep, direnv, git-lfs, gron, yarn) are
# managed by mise. See mise/install.sh. Only things mise can't/shouldn't manage live here.
# Docker (CLI, Colima, compose, lazydocker) is installed by docker/install.sh, not Docker Desktop.

# Core
brew "mise"   # manages the runtimes and CLI tools below; installed here so it is upgraded with Homebrew and lives in its bin dir
brew "git"
brew "gnupg"
brew "coreutils"
brew "wget"
brew "nmap"

# Editors & terminal
brew "vim"
brew "tmux"
brew "universal-ctags"

# Ruby native-extension dependencies (mise compiles Ruby from source if needed)
brew "openssl@3"
brew "libyaml"
brew "readline"
brew "libffi"
brew "gdbm"
brew "imagemagick"

# Databases / services
brew "memcached"
brew "mysql@8.4"   # pinned (current LTS)
brew "postgres"    # alias for the latest PostgreSQL; unused today, here to try out
brew "redis"

# Applications
cask "obsidian"
