#!/bin/sh
#
# dot
#
# `dot` handles installation, updates, things like that. Run it periodically
# to make sure you're on the latest and greatest.
export DOTHOME=$HOME/.dotfiles

DISTRO=$(uname)
case $DISTRO in
  'Linux')
    sudo apt-get update
    sudo apt-get -y -q upgrade
    ;;
  'Darwin')
    # Ask every question up front (languages, tools, fonts, apps, Neovim, oh-my-zsh and its plugins)
    # so the slow steps below run unattended. Installs Xcode CLT, Homebrew and
    # mise first, because answers are validated against them.
    bash $DOTHOME/script/ask
    # script/ask may have just installed Homebrew in its own process, so this
    # shell's PATH does not have it yet. Put it there for the steps below.
    for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
      if [ -x "$brew_bin" ]; then
        eval "$("$brew_bin" shellenv)"
        break
      fi
    done
    # Install/upgrade homebrew packages
    echo "Homebrew update"
    bash $DOTHOME/homebrew/install.sh 2>&1
    echo "Docker update (Colima + CLI; not Docker Desktop)"
    bash $DOTHOME/docker/install.sh 2>&1
    # Languages (ruby, node, ...) and CLI tools via mise
    echo "mise update"
    bash $DOTHOME/mise/install.sh 2>&1
    echo "Fonts update"
    bash $DOTHOME/fonts/install.sh 2>&1
    echo "Applications update"
    bash $DOTHOME/apps/install.sh 2>&1
    echo "Neovim update"
    bash $DOTHOME/neovim/install.sh 2>&1
    echo "oh-my-zsh update"
    bash $DOTHOME/zsh/install.sh 2>&1
    # Claude Code status line (only if Claude Code is in use; never overwrites)
    bash $DOTHOME/claude/install.sh 2>&1
    # Symlink databases
    echo "Database(s) update"
    bash $DOTHOME/databases/install.sh 2>&1
    ;;
  *)
    echo "Good luck with that"
    ;;
esac

# Install vim bundles
$DOTHOME/vim/install.sh 2>&1
