#
# ENV VARIABLES
#
# Gemfury key for Kalkomey's private aios gems (aios-claude and aios).
# This is a 1Password reference, not the key. The installer (ruby/install.sh) reads it with the
# 1Password CLI (`op`), which needs 1Password unlocked with "Integrate with 1Password CLI" on.
# You can put the key itself here instead.
# Bundler also reads this variable for gem.fury.io. Our app Gemfiles carry their own token, so
# they do not use it. If a project's Gemfile relies on it, that project needs the real key:
# run it as `op run -- bundle install`.
export BUNDLE_GEM__FURY__IO="op://Developers/AIOS Operator Keys/Gem Fury Read-only"

#
# ALIASES
#
#alias brewup="brew update && brew upgrade && brew cleanup"
#alias ll="ls -alhF --color=always | less -R -F -X"
#alias reload="source ~/.zshrc"

#
# FUNCTIONS
