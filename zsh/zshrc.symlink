# shortcut to this dotfiles path is $DOTHOME
export DOTHOME=$HOME/.dotfiles

# source folder that we can `scd [tab]` into
export SOURCE_DIR=$HOME/src

# aios worktrees root, used by mux() and its completion
export AIOS_WORKTREES=$HOME/aios/worktrees

# all of our zsh files
typeset -U config_files
config_files=($DOTHOME/**/*.zsh)

# load the path files
for file in ${(M)config_files:#*/path.zsh}
do
  source $file
done

# load everything but the path and completion files
for file in ${${config_files:#*/path.zsh}:#*/completion.zsh}
do
  source $file
done

# initialize autocomplete here, otherwise functions won't be loaded
autoload -Uz compinit
compinit

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion.zsh}
do
  source $file
done

unset config_files

# I want to use [ and ] damn it!
unsetopt nomatch

# set cd autocompletion to commonly visited directories
cdpath=(. ~ ~/src $SOURCE_DIR)

# go, rust, et al
export PATH="$HOME/.cargo/bin:$PATH"

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

export DOCKER_PLATFORM="linux/$(uname -m)"

# Homebrew, then mise, in that order. `brew shellenv` puts Homebrew's bin dirs at
# the front of PATH, and `mise activate` then puts mise's tool dirs in front of
# those, so the ruby/node/etc. you get are mise's, not copies Homebrew installed as
# dependencies of other formulae. Don't move mise above this, and don't run
# `brew shellenv` after it. (Homebrew's installer usually adds this line to
# ~/.zprofile already; repeating it here is harmless and means this file does not
# depend on that.)
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# mise manages ruby, node, and CLI tools (see mise/install.sh). Activate it
# before oh-my-zsh so tools it provides (fzf, direnv, zoxide) exist when plugins load.
eval "$(mise activate zsh)"

# oh-my-zsh. zsh/install.sh installs it and writes the chosen plugin list.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git)
[ -r "$HOME/.config/dotfiles/zsh-plugins.zsh" ] && source "$HOME/.config/dotfiles/zsh-plugins.zsh"
[ -r "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# oh-my-zsh plugins define aliases that collide with ours (gc, gd, gca, ...).
# Re-source ours so the dotfiles versions (e.g. signed commits) win.
for f in $DOTHOME/**/aliases.zsh(N); do source $f; done

# import local zsh customizations, if present
zrcl="$HOME/.zshrc.local"

[[ ! -a $zrcl ]] || source $zrcl
